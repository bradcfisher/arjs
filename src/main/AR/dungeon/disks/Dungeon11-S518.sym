rw  63b2,1   INV_GOLD               ; Low byte of Gold inventory (uint16)
rw  63b3,1   INV_SILVER_U16_HI      ; High byte of Silver inventory (uint16)
rw  63b4,1   INV_SILVER             ; Low byte of Silver inventory (uint16)
rw  63b5,1   INV_COPPER_U16_HI      ; High byte of Copper inventory (uint16)
rw  63b6,1   INV_COPPER             ; Low byte of Copper inventory (uint16)
rw  63b7,1   INV_GEMS_U16_HI        ; High byte of Gems inventory (uint16)
rw  63b8,1   INV_GEMS               ; Low byte of Gems inventory (uint16)
rw  63b9,1   INV_JEWELS_U16_HI      ; High byte of Jewels inventory (uint16)
rw  63ba,1   INV_JEWELS             ; Low byte of Jewels inventory (uint16)
rw  63bb,1   INV_FOOD               ; Number of food packets in inventory (uint8)
rw  63bc,1   INV_WATER              ; Number of water flasks in inventory (uint8)
rw  63bd,1   INV_TORCHES            ; Number of unlit torches in inventory (uint8)
rw  63be,1   INV_CRYSTALS           ; Number of crystals in inventory (uint8)
rw  63bf,1   INV_KEYS               ; Number of keys in inventory (uint8)
rw  63c0,1   INV_COMPASSES          ; Number of compasses in inventory (uint16)
rw  63c1,1   INV_TIMEPIECES         ; Number of timepieces in inventory (uint16)

; What are 63c2 ... 63d1?

rw  63d2,b   dat_63d2               ; 11? bytes

rw  640b,40  InvItemAdr_L           ; 64 bytes: Holds LSBs of inventory item addresses
rw  644b,40  InvItemAdr_H           ; 64 bytes: Holds MSBs of inventory item addresses
rw  648b,8   InvSlotFree            ; 8 bytes: Bitfield with one bit per inventory slot. 1 = free, 0 = allocated
                                    ;    addItem: clears bits
                                    ;    sub_4c6b: tests bits
                                    ;    sub_4c86: clears bits
                                    ;    sub_4c5a: sets bits
rw  6493,1   dat_6493               ; 1 byte
rw  6494,10  dat_6494               ; 16? bytes: ... related to dropped items ...
                                    ;    - sub_4efd: Set to 2
rw  64a4,10  dat_64a4               ; 16? bytes: Holds item location X coordinate for dropped items
rw  64b4,10  dat_64b4               ; 16? bytes: Holds item location Y coordinate for dropped items
rw  64c4,10  dat_64c4               ; 16? bytes: Holds item location map number for dropped items
rw  64d4,10  dat_64d4               ; 16? bytes: Holds item indexes for dropped items

rw  64e4,1   CHR_ItemsEnd_L         ; 1 byte: LSB of current end of item data in the range $6900 [CHR_Items] to $75ff.
rw  64e5,1   CHR_ItemsEnd_H         ; 1 byte: MSB of current end of item data in the range $6900 [CHR_Items] to $75ff.

rw  6500,400 CHR_Effects            ; Currently active effects applied to player
                                    ;   1024 bytes: Array of 64 x 16-byte elements
                                    ;    - Disease / Curse / Active magic descriptions
                                    ;    - Timer based effects
                                    ;    - ?

rw  6900,d00 CHR_Items              ; 3328 bytes: Items currently present in the game
                                    ;   Contains variable length entries. Locations for each item are stored
                                    ;   in InvItemAdr_L/H (max 64 entries)

rw  7600,1   ModuleNumber           ; Currently loaded scenario or map number
x   7601,3   moduleEntry1           ; First entry point for scenario
x   7604,3   moduleEntry2           ; Second entry point for scenario
x   7607,3   moduleEntry3           ; Third entry point for scenario

x   760a,3   moduleEntry4           ; Fourth entry point for scenario
r   760a,1   Mod0DescTbl_L          ; Module 0: LSB of description table
r   760b,1   Mod0DescTbl_H          ; Module 0: MSB of description table

rw  96f0,1   TEX_Headers            ; Location where textures are loaded into memory (5392 bytes)

rw  ac00,1   MAP_Number             ; Number/ID of the loaded map
rw  ac01,1   MAP_DescTbl_L          ; LSB of map description table (offset from $ac00 for std maps)
rw  ac02,1   MAP_DescTbl_H          ; MSB of map description table (always $ac for std maps)
rw  ac03,1   MAP_DESC_FRAG_TBL      ; Start of description fragment table

rwx f9f4,1   sub_f9f4               ; Called from sub_2979. Defined in KERNEL_LOADER and only present on 64KB+ systems.

