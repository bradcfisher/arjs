                                    ;     Forward movement
                                    ;      0: $01 - Y (North)
                                    ;      1: $00 - X (East)
                                    ;      2: $01 - Y (South)
                                    ;      3: $00 - X (West)
                                    ;     Backward movement (player orientation + 4)
                                    ;      4: $01 - Y (North)
                                    ;      5: $00 - X (East)
                                    ;      6: $01 - Y (South)
                                    ;      7: $00 - X (West)
rw  3b4c,8   MovePropAmt            ; 8 bytes: Movement orientation to movement amount
                                    ;     Forward movement
                                    ;      0: $24 ( 36) - (North)
                                    ;      1: $dc (-36) - (East)
                                    ;      2: $dc (-36) - (South)
                                    ;      3: $24 ( 36) - (West)
                                    ;     Backward movement (player orientation + 4)
                                    ;      4: $dc (-36) - (North)
                                    ;      5: $24 ( 36) - (East)
                                    ;      6: $24 ( 36) - (South)
                                    ;      7: $dc (-36) - (West)
rw  3b54,8   MoveStepDir            ; 8 bytes: Direction step for orientation
                                    ;   Forward movement
                                    ;     0: $ff - -1 (North)
                                    ;     1: $01 - +1 (East)
                                    ;     2: $01 - +1 (South)
                                    ;     3: $ff - -1 (West)
                                    ;   Backward movement (player orientation + 4)
                                    ;     4: $01 - +1 (North)
                                    ;     5: $ff - -1 (East)
                                    ;     6: $ff - -1 (South)
                                    ;     7: $01 - +1 (West)

