Altirra symbol file

; Symbols for Dungeon Disk 1 Side 1 sector 518 - Game Kernel
; Both this file and Dungeon11-S205.sym should be applied for full symbol mapping.
;
[symbols]

rw  0000,1   SioBufPos_L            ; LSB of current serial IO buffer position (next byte to write/read).
rw  0001,1   SioBufPos_H            ; MSB of current serial IO buffer position (next byte to write/read).

; Next 4 bytes are used for multiple purposes (converting int to string, multiplication, division, etc)
rw  0002,4   BcdData                ; out_UInt32ToDec, unpackBcdByte: Holds BCD data to unpack/output

rw  0002,4   BEResult               ; multBEInt16, readBEUInt16 output: Big endian unsigned 32 or 16-bit integer result
rw  0002,2   BEParam1               ; multBEInt16 input: Big endian 16-bit unsigned integer input multiplicand 1

rw  0002,2   LEResult               ; multBytes output: Little endian 16-bit unsigned integer result
rw  0004,1   MBTemp1                ; multBytes temp: Holds initial value of A (multiplicand 1)
                                    ;     Kernel loader: sub_819e: used for temp storage
rw  0005,1   MBTemp2                ; multBytes temp: Holds bit-shifted values of Y (multiplicand 2)

rw  0002,1   DivQuotient            ; divByteBy10, divUint16Uint8: Quotient of result
rw  0003,1   DivRemainder           ; divByteBy10, divUint16Uint8: Remainder of result
rw  0004,1   DivDivisor             ; divByteBy10, divUint16Uint8: Holds input X value

rw  0006,1   dat_0006               ; 1 byte:
                                    ;   used as:
                                    ;     - readBEUInt16: loop ctl var
                                    ;     - loop ctl var in KERNEL_LOADER sub_80d2
                                    ;     -  in KERNEL_LOADER sub_f9f4
rw  0007,2   BEParam2               ; multBEInt16 input: Big endian 16-bit unsigned integer input multiplicand 2
rw  0007,1   SourceAdr_L            ; LSB of address typically used as a source for copying or comparison
rw  0008,1   SourceAdr_H            ; MSB of address typically used as a source for copying or comparison
rw  0009,1   dat_0009_L             ; LSB of address. Related to $190b. display list related     (DestAddr?? / AddrParam2??)
                                    ;    - sdmInitGamePlay   - (temp) LSB of (DISP_GFX_TOP + $1d) address / gfx charset addrs
                                    ;    - copyBytes         - (input) LSB of destination address
                                    ;    - copyBytesNeg      - (input) LSB of destination address
                                    ;    - removeItem        - (temp) addr of item, param to copyBytes
                                    ;    - addItem           - (temp) Set to destination addr LSB for copyBytes
                                    ;
rw  000a,1   dat_0009_H             ; MSB of address. Related to $190c. display list related
                                    ;    - sdmInitGamePlay   - (temp) MSB of (DISP_GFX_TOP + $1d) address / gfx charset addrs
                                    ;    - ab_Clear2Eol - used as dest addr for writing spaces to screen
                                    ;    - copyBytes         - (input) MSB of destination address
                                    ;    - copyBytesNeg      - (input) MSB of destination address
                                    ;    - removeItem        - (temp) addr of item, param to copyBytes
                                    ;    - addItem           - (temp) Set to destination addr MSB for copyBytes
                                    ;
rw  000b,1   dat_000b               ; LSB of int16
                                    ;    - copyBytesNeg      - (input) LSB of negated 16-bit size
rw  000c,1   dat_000c               ; ?LSB of address?  LSB of int16
                                    ;    - copyBytesNeg      - (input) MSB of negated 16-bit size
rw  000d,1   dat_000d_L             ; LSB of address
rw  000e,1   dat_000d_H             ; MSB of address
rw  000f,1   dat_000f               ; 1 byte
rw  0010,1   MapCell_L              ; LSB of address of current map cell data.
rw  0011,1   MapCell_H              ; MSB of address of current map cell data.
rw  0012,1   DescTbl_L              ; LSB of current map location description table address
rw  0013,1   DescTbl_H              ; MSB of current map location description table address
rw  0014,1   DescFrag_L             ; LSB of address in current map description fragment table
rw  0015,1   DescFrag_H             ; MSB of address in current map description fragment table
rw  0016,1   StrTmplate_L           ; LSB of address of string template to interpolate and output
rw  0017,1   StrTmplate_H           ; MSB of address of string template to interpolate and output
rw  0018,1   OutGetWord_L           ; LSB of word read from template string by getNextWord
