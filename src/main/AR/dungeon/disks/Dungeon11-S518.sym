                                    ;     1: $80 - High nibble (East)
                                    ;     2: $00 - Low nibble  (South)
                                    ;     3: $80 - High nibble (West)
                                    ;   Backward movement (player orientation + 4)
                                    ;     4: $00 - Low nibble  (North)
                                    ;     5: $80 - High nibble (East)
                                    ;     6: $00 - Low nibble  (South)
                                    ;     7: $80 - High nibble (West)
