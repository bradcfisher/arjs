                                    ;     1: $00 - MAP_WALL_E_N (East)
                                    ;     2: $01 - MAP_WALL_W_S (South)
                                    ;     3: $01 - MAP_WALL_W_S (West)
                                    ;   Backward movement (player orientation + 4)
                                    ;     4: $01 - MAP_WALL_W_S (North)
                                    ;     5: $01 - MAP_WALL_W_S (East)
