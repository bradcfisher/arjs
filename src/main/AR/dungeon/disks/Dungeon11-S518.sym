             ; Values related to outputChar
rw  001a,1   OutTempA               ; 1 byte: Used in outputChar to preserve/restore A
rw  001b,1   OutTempX               ; 1 byte: Used in outputChar to preserve/restore X
rw  001c,1   OutTempY               ; 1 byte: Used in outputChar to preserve/restore Y
rw  001d,1   OutAddr_L              ; LSB of dest addr in display buffer
rw  001e,1   OutAddr_H              ; MSB of dest addr in display buffer
rw  001f,1   OutCol                 ; Current output column in display buffer (analogous to cursor column/COLCRS)
rw  0020,1   OutRow                 ; Current output row in display buffer (analogous to cursor row/ROWCRS)
rw  0021,1   OutBlink               ; Current output inverse/blink flag.  ORd with each byte output.

             ; Values related to printTop/Btm/Any
rw  0023,1   dat_0023               ; 1 byte: mode?/nesting depth? (0, 1 or 2)
                                    ;   An index into SavedOutCol, SavedOutRow, tbl_18c7, ModeTopRow, ModeNumRows
rw  0024,1   OutAlign               ; 1 byte: Only bits 6 and 7 are used, remaining bits are ignored
                                    ;    Bit 7-6: 00 - Left aligned output: Character in A is output if not $0d (13)
                                    ;             10 - Compute center alignment then outputs at computed location.
                                    ;             11 - Compute right alignment then outputs at computed location.
                                    ; (printTop/BTM/ANY (set 0), a5_Center (set $80), a7_RightAlign (set $c0), ab_Clear2Eol (use))
