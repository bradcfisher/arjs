rw  1c19,4   tbl_COLPF2             ; 4 byte lookup table of row background (COLPF2) colors
                                    ;     0: $46 - Mid-intensity Red (reddish-orange, #9e4b4d)
                                    ;     1: $68 - Mid-intensity Cobalt Blue (lavendar-ish, #a75bed)
                                    ;     2: $88 - Mid-intensity Medium Blue (grayish-blue, #7570ff)
                                    ;     3: $b6 - Mid Olive-Green ( #2b8362 )
                                    ;        (This value overlaps with tbl_COLPM3 below, but is part of tbl_COLPF2)
rw  1c1c,6   tbl_COLPM3             ; 5 byte lookup table (starts at index 1)
                                    ;     0: not used (actually last entry of tbl_COLPF2 above)
                                    ;     1: $76 - COLPF0: Mid-intensity Ultramarine Blue (purplish, #7649f9)
                                    ;     2: $9e - COLPF1: Light-intensity dark blue (powder blue, #cbefff)
                                    ;     3: $34 - COLPF2: Dark Orange (brownish, #6e3200)
                                    ;     4: $00 - COLPF3: Black (black, #000000)
                                    ;     5: $00 - COLBK: Black (black, #000000)
rw  1c21,3   tbl_CLEAR_NUM          ; 3 bytes: Lookup for setDisplayMode
                                    ;   Number of 0's to fill starting at $04C8 [DISP_LINE6]
                                    ;     0: $00 (0 = clear 1 byte) - ...same byte as tbl_COLPM3[5] above...
                                    ;     1: $27 (39 = clear 40 bytes)
                                    ;     2: $13 (19 = clear 20 bytes)

rw  1c24,4   tbl_HPOSM              ; 4 byte lookup table of Missile positions (M3=$20, M2=$28, M1=$d0, M0=$d8)
rw  1c28,4   tbl_HPOSP              ; 4 byte lookup table of Player  positions (P3=$38, P2=$ac, P1=$00, P0=$00)

