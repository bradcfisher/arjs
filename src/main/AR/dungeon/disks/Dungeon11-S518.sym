rw  0026,1   OutAlignEolFlg         ; 1 byte: End of line reached if bit 7 is set
rw  0027,1   AlignStart_L           ; LSB of start of text being center or right aligned. Used to reset to beginning for output after length is computed.
rw  0028,1   AlignStart_H           ; MSB of start of text being center or right aligned. Used to reset to beginning for output after length is computed.
rw  0029,4   tmp_BE_UINT32          ; 4 bytes: Temp big-endian uint32 to convert to string

rw  002d,1   OutWidth               ; 1 byte: Output width for value

rw  002e,1   StickStatus            ; Port 1 Stick 0 direction and trigger button status
                                    ;   Bit    7 - Button status (1 = pressed, 0 = not pressed)
                                    ;     $80 (10000000) - trigger pressed
                                    ;   Bits 3-0 - Direction (0 = centered, xxx)
                                    ;     $01 (00000001) - forward
                                    ;     $04 (00000100) - left
                                    ;     $02 (00000010) - back
                                    ;     $08 (00001000) - right
rw  002f,1   StickKbdDir            ; Key-based joystick direction and trigger button status
                                    ;     I -> forward, J -> left, K -> back, L -> right, space -> trigger
rw  0030,1   KbdPendChar            ; ATASCII of most recent key read, but not yet processed/accepted
