                                    ;             11 - Compute right alignment then outputs at computed location.
                                    ; (sub_1c84/sub_1c88/sub_1c8c (set 0), a5_CNTR_ALGN (set $80), a7_RGHT_ALGN (set $c0), ab_CLR_2_EOL (use))
