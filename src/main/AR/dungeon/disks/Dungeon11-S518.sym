                                    ;     the next one
rwx 4936,3   smc_4936               ; The address for this JMP is dynamically modified
rwx 4939,1   contNextAttr           ; Moves AttrAddr_L/H forward dat_0053 bytes, sets Y = AttrSize &
                                    ;     continues @ $4984 [contIterEffect]
rwx 494d,1   contIncAttr            ; Increases attribute at AttrAddr_L/H by amount in AttrAdjAmt &
                                    ;     continues @ $4939 [contNextAttr]
rwx 4953,1   contDecAttr            ; Decreases attribute at AttrAddr_L/H by amount in AttrAdjAmt &
                                    ;     continues @ $4939 [contNextAttr]
rwx 4959,1   contBitAttr            ; Applies a bitwise operation (XOR, AND, OR) assigned in applyEffects to Y bytes
                                    ;     starting at AttrAddr_L.
rwx 495b,1   smc_495b               ; Self-modifying code: Assigned one of $45 (EOR), $25 (AND) or $05 (ORA)

rw  4965,3   EffectBitOps           ; Op assigned to smc_495b
                                    ;   0: $45 = EOR zpg
                                    ;   1: $25 = AND zpg
                                    ;   2: $05 = ORA zpg

