                                    ;   $10 (16) = If SELECT key was released
                                    ;   $11 (17) = If START key was released
                                    ;   $12 (18) = If OPTION key was released
rw  0031,1   KbdChar                ; ATASCII of most recent key read by readKey
rw  0032,1   flg_PAUSED             ; If <0, then gamed is paused
