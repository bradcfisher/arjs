; $0100 to $01ff holds the stack
;-----
rw  0100,80  SioBuf                 ; 128 bytes: Used for serial I/O data frame buffer (Note: Overlaps stack frame)

rw  0103,1   rnd_0103               ; Used in randInRange as a reference to a value 3 bytes back on the
                                    ;    stack (e.g. TSX, LDA rnd_0103,X).
rw  0180,10  DecryptKeyBuf          ; 16 bytes: Used as decryption key data buffer
