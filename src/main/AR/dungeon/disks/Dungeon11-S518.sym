rw  199d,21  DLIST_199d             ; DLIST data (33 bytes)
                                    ; This display list seems to be a 40x25? 1bpp character display (20 + 25 * 8 = 220 scanlines?)
                                    ;   $70 $70 $30 - 8 + 8 + 4 [20] blank scanlines
                                    ;   $42 $00 $04 - 1 row of 8x8 1bpp characters w/Load memory scan [$02 + $40]
                                    ;                 resets display memory position to $0400
                                    ;   $02 $02 $02 $02 $02 $02 $02 $02 - 24 rows of Graphic mode 0 - 40x24 8x8 1bpp characters
                                    ;   $02 $02 $02 $02 $02 $02 $02 $02
                                    ;   $02 $02 $02 $02 $02 $02 $02 $02
                                    ;   $41 $9d $19 - JVB $199d - Jump on vblank to $199d [DLIST_199d], e.g. repeat
rw  19be,31  DLIST_19be             ; DLIST data (49 bytes)
                                    ; This display list is used to render the normal gameplay
                                    ; 23 total lines of text
                                    ;   6 lines of text (Normal 1bpp Dungeon character set)
                                    ;   9 lines of gfx area (2bpp character set used as graphics)
                                    ;   8 lines of text (Normal 1bpp Dungeon character set)
                                    ; (20 + 8 + 5*9 + 9*8 + 2 + 8 + 7*9 = 210 scanlines)
                                    ;   $70 $70 $30 - 8 + 8 + 4 [20] blank scanlines
                                    ;   $42 $00 $04 - 1 row of 8x8 1bpp characters w/Load memory scan [$02 + $40]
                                    ;                 resets display memory position to $0400
                                    ;   $80 $02 $80 $02 $80 $02 $80 $02 - 4 x Skip 1 scanline w/display list interrupt [$00 + $80]
                                    ;                                         & 1 row of 8x8 1bpp characters [$02]
                                    ;   $02         - 1 row of 8x8 1bpp characters
                                    ;   $80         - Skip 1 scanline w/display list interrupt
                                    ;   $44 $f0 $04 - 1 row of 8x8 2bpp characters w/Load memory scan
                                    ;                 resets display memory position to $04f0
                                    ;   $04         - 1 row of 8x8 2bpp characters
                                    ;   $84 $84     - 2 rows of 8x8 2bpp characters w/display list interrupt
                                    ;   $04         - 1 row of 8x8 2bpp characters
                                    ;   $84         - 1 row of 8x8 2bpp characters w/display list interrupt
                                    ;   $04 $04     - 2 rows of 8x8 2bpp characters
                                    ;   $84         - 1 row of 8x8 2bpp characters w/display list interrupt
                                    ;   $00 $00     - Skip 2 scanlines
                                    ;   $42 $58 $06 - 1 row of 8x8 1bpp characters w/Load memory scan [$02 + $40]
                                    ;                 resets display memory position to $0658 []
                                    ;   $00 $02 $00 $02 $00 $02 $00 $02 - 7 x Skip 1 scanline [$00]
                                    ;                                         & 1 row of 8x8 1bpp characters [$02]
                                    ;   $00 $02 $00 $02 $00 $02
                                    ;   $41 $be $19 - JVB $19be - Jump on vblank to $19be [DLIST_19be], e.g. repeat

