rw  0208,2   VKEYBD                 ; Standard keyboard interrupt vector
rw  020c,2   VSEROR                 ; POKEY serial I/O transmit ready interrupt vector
rw  020e,2   VSEROC                 ; POKEY Serial bus transmit complete interrupt vector
rw  0216,2   VIMIRQ                 ; IRQ immediate interrupt vector
rw  0222,2   VVBLKI                 ; VBLANK immediate interrupt vector
rw  0224,2   VVBLKD                 ; VBLANK deferred interrupt vector

rw  022f,1   vblk_CRITIC            ; Critical region flag (prevents VVBLKD if <0)

             ; The following 4 properties match the structure of the SioCmdBuf
rw  0230,1   DiskNumber             ; Disk Number (ATASCII value between '1' and '4' inclusive)
rw  0231,1   DiskCommand            ; Disk Command Code
rw  0232,1   DiskSector_L           ; LSB of Disk sector number
rw  0233,1   DiskSector_H           ; MSB of Disk sector number

rw  0234,1   SioSize_L              ; LSB: uin16 of Serial I/O byte size (bytes read or bytes to write)
rw  0235,1   SioSize_H              ; MSB: uin16 of Serial I/O byte size (bytes read or bytes to write)
rw  0236,1   CUR_IRQEN              ; Current value to write to IRQEN
rw  0237,1   CUR_SKCTL              ; Current value to write to SKCTL
rw  0238,1   SioReplyStatus         ; Assigned the SioStatus value after reading the ACK byte in sioReadReply.
                                    ;   Can be assigned back into SioStatus in contRtn_2097 if SioErrReply is true.
rw  0239,1   SioCntdwn              ; Non-0 if SIO timeout countdown active (no timeout yet), 0 if SIO timeout occurred
rw  023a,1   SioBufEnd_L            ; LSB of end of current serial IO buffer (first byte after end of buffer)
rw  023b,1   SioBufEnd_H            ; MSB of end of current serial IO buffer (first byte after end of buffer)
rw  023c,1   SioChksum              ; Serial transmission checksum
rw  023d,1   SioStatus              ; Serial IO status
                                    ; May be set to:
                                    ;     $01 (SUCCES - Successful operation)
                                    ;     $8a (TIMOUT - Device timeout)
                                    ;     $8b (DNACK  - Device doesn't acknowledge command)
                                    ;     $8c (FRMERR - Serial input frame error)
                                    ;     $8e (OVRRUN - Serial input overrun, data lost)
                                    ;     $8f (CHKERR - Serial bus checksum error)
                                    ;     $90 (DERROR - Device error)
rw  023e,1   SioCmdRetries          ; Number of serial I/O command frame send retries remaining
rw  023f,1   SioRetries             ; Number of serial I/O complete operation retries remaining
rw  0240,1   SioRecvDone            ; Serial buffer receieve complete flag (0 = in process; non-0 = completed)
rw  0241,1   SioXmitDone            ; Serial buffer transmission complete flag (0 = in process; non-0 = completed)
rw  0242,1   SioBufferFull          ; Serial receive buffer full flag (0 = space remaining, $ff = buffer full)
rw  0243,1   SioChksumSent          ; Used during serial I/O transmission to indicates whether the checksum has been
                                    ;   sent or not. (0 = checksum not sent, $ff = checksum was sent)
rw  0245,1   SioNeedChksum          ; Whether a checksum byte is expected to follow incoming serial I/O data or not.
                                    ;   (0 = checksum not expected, $ff = checksum expected)
rw  0246,1   SioXferMode            ; Serial I/O transfer mode. Assigned before executing a serial I/O command.
                                    ;   - $00             = command mode is immediate
                                    ;   - $40 (bit 6 = 1) = command mode is data receive
                                    ;   - $80 (bit 7 = 1) = command mode is data send
rw  0247,1   SioTimeoutSecs         ; Approximate number of seconds to use for a timeout value while waiting for the
                                    ;    COMPLETE response byte to be received. (multiply value by 64 for number of
                                    ;    vblanks, or by 1.067 on NTSC or 1.28 on PAL for seconds)
rw  0248,1   CUR_VDSLSTL            ; LSB of current VDSLST (Display list interrupt vector)
rw  0249,1   CUR_VDSLSTH            ; MSB of current VDSLST (Display list interrupt vector)
;rw  024a,1                          ; LSB of display list A
;rw  024b,1                          ; MSB of display list A

rw  024c,1   SioTimeout_L           ; LSB of SIO timeout value in vblanks (e.g. 60/second)
rw  024d,1   SioTimeout_H           ; MSB of SIO timeout value in vblanks (e.g. 60/second)
rw  024e,4   dat_024e               ; 4 bytes:
                                    ;    - related to a disk number (each byte maps to a disk)
                                    ;    - byte for disk is initialized to $ff
                                    ;    -
                                    ;    - only used in kernel loader: sub_80d2
rw  0253,1   dat_0253               ; 1 byte - used in sub_24c6  -   a countdown applied during display mode changes?
                                    ;    - setDisplayMode sets dat_0253 to 0 for mode 0 and 3 for modes 1,2
                                    ;    - sdmInitPlainTxt (mode 0) sets dat_0253 to 0
                                    ;    - irq_VVBLKI
                                    ;       - calls vblk_cont_230a when dat_0253 is < 0
                                    ;       - decrements dat_0253 if it is greater than 0 and sets display list to blank screen
                                    ;       - sets the display list and NMI handler (VDSLST) when dat_0253 = 0
                                    ;    - sub_245d - sets dat_0253 = $80
                                    ;    - sub_24c6 - sets dat_0253 = 1
                                    ;    - kernelInit - sets dat_0253 = 2
rw  0254,1   CurDList_L             ; LSB of current DLIST addr
rw  0255,1   CurDList_H             ; MSB of current DLIST addr
rw  0256,1   dat_0256               ; Related to blinking text?  Maybe enable/disable blinking text flag?
                                    ;   - irq_VVBLKI
                                    ;      - when dat_0253 = 0
                                    ;        - reads and increments dat_0256 if it is 0 and returns to caller if not 0
                                    ;      - decremented in (cont) vvblki_BLINK
rw  0257,1   SioErrReply            ; Set to $ff if an error status was received while reading an ACK/COMPLETE response,
                                    ;    otherwise 0. Note, will be 0 on timeout, since no response was received.
rw  0258,1   SysMemorySize          ; 1 byte: Detected memory size (assigned by sub_819e in KERNEL_LOADER)
                                    ;         0 = 48K, $80 = 64K, $c0 = 128K (and higher?)
rw  0259,1   dat_0259               ; 1 byte
rw  025a,1   dat_025a               ; 1 byte: flag indicating the value of the bit in dat_2a38_unk corresponding to
                                    ;     a FileNumber.
                                    ;     - sub_2979: Only matters for systems with 128KB or more of RAM. Perhaps
rw  025b,1   dat_025b               ; 1 byte - only set to 0?
rw  025c,1   dat_025c               ; 1 byte - only written?
rw  025d,1   dat_025d               ; 1 byte: only used by kernel loader?
                                    ;     - sub_f9f4: Set to $80 if the disk sector being read is even
                                    ;                 Set to 0 if the disk sector being read is odd
rw  025e,1   dat_025e               ; 1 byte: LSB of sector number
rw  025f,1   dat_025f               ; 1 byte: MSB of sector number
rw  0260,1   dat_0260               ; 1 byte: LSB of sector number
rw  0261,1   dat_0261               ; 1 byte: MSB of sector number
rw  0262,1   dat_0262_L             ; 1 byte: LSB of sector number (input file sector)
rw  0263,1   dat_0262_H             ; 1 byte: MSB of sector number (input file sector)
rw  0264,1   dat_0264               ;
rw  0265,1   dat_0265               ; 1? byte
rw  0266,4   SioCmdBuf              ; 4 bytes: Used as SIO command frame buffer
rw  0266,1   SioCmdDiskNumber       ; Disk Number (ATASCII value between '1' and '4' inclusive)
rw  0267,1   SioCmdDiskCommand      ; Disk Command Code
rw  0268,1   SioCmdDiskSector_L     ; LSB of Disk sector number
rw  0269,1   SioCmdDiskSector_H     ; MSB of Disk sector number
rw  0270,1   SioAck                 ; 1 byte: Assigned the serial I/O ACK or COMPLETE byte received
                                    ; One of:
                                    ;   $41 ('A') - ACK (Received in response to command or data frame)
                                    ;                 - Command frame: Device accepted the command and aux args
                                    ;                 - Data frame: Data received and checksum validated
                                    ;   $4e ('N') - NAK (Received in response to command or data frame)
                                    ;                 - Command frame: Device refused the command or aux args
                                    ;                 - Data frame: Checksum error
                                    ;   $43 ('C') - COMPLETE (device completed the command, data may follow)
                                    ;   $45 ('E') - ERR (error occurred executing the command)

; Disk segment directory
; This table of 4-byte entries describes the various files stored on the game disks.
; Data includes disk and side, length.
; Entries have the following 4 bytes
;   0 - Bit 6 has an unknown meaning. Bits 3-5=disk #, Bit 2=disk side, Bits 0-1=bits 9-10 of sector
;   1 - Bits 0-8 of 10 bit sector number (1-based). For most entries, this value refers to the key sector, data in next sector.
;   2 - High byte of uint16 file size
;   3 - Low byte of uint16 file size
rw  0280,113 FILE_SEG_DIR           ; Start of file segment directory

rw  0400,8c0 DISP_START             ; 2240 bytes: 23 rows x 40 characters

rw  0401,19  DISP_NAME              ; Position in display buffer to write player name (text - 25 characters)

rw  0425,1   DISP_LEVEL             ; Position in display buffer to write player level (text - 2 chars, left justified)
rw  0453,1   DISP_TIME_SPNR         ; Position in display buffer to write time spinner char (text - 1 char)
rw  0459,3   DISP_STA_VAL           ; Position in display buffer to write STA stat (text - 3 chars, left justified)
rw  045e,3   DISP_CHA_VAL           ; Position in display buffer to write CHA stat (text - 3 chars, left justified)
rw  0463,3   DISP_STR_VAL           ; Position in display buffer to write STR stat (text - 3 chars, left justified)
rw  0468,3   DISP_INT_VAL           ; Position in display buffer to write INT stat (text - 3 chars, left justified)
rw  046d,3   DISP_WIS_VAL           ; Position in display buffer to write WIS stat (text - 3 chars, left justified)
rw  0472,3   DISP_SKL_VAL           ; Position in display buffer to write SKL stat (text - 3 chars, left justified)
rw  0484,3   DISP_EXP_VAL           ; Position in display buffer to write player experience points (text- 10 chars, left justified)
rw  0499,1   DISP_HP_SEP_CHAR       ; Position in display buffer to write ':' (HP < Max) or '=' (HP = Max) (text - 1 char)
rw  049a,5   DISP_HP_VAL            ; Position in display buffer to write current HP (text - 5 chars, left justified)
rw  04a0,28  DISP_YOU_ARE           ; 40 bytes: Start of 5th row of text (e.g. "You are in a well-lighted area.", etc.)
rw  04a1,27  DISP_LOC_DESC          ; Position in display buffer to write location description (text - 39 chars, left justified, starting with "You are ")
rw  04c9,27  DISP_SOMETHING_HERE    ; Position in display buffer to write "There is something here." (text - 39 chars, left justified)

rw  04c8,28  DISP_LINE6             ; 40 bytes: Start of 6th row of text (e.g. "There is something here" or similar)
rw  04f0,78  DISP_GFX_TOP           ; 120 bytes: Position in display buffer containing top third of "graphical" area
rw  0568,78  DISP_GFX_MDL           ; 120 bytes: Position in display buffer containing middle third of "graphical" area
rw  05e0,78  DISP_GFX_BTM           ; 120 bytes: Position in display buffer containing bottom third of "graphical" area

; The following are for reference, but aren't actually updated while navigating
; Instead, the bits of the underlying character set are updated to change the display.
rw  0543,6   DISP_CMPS_L1           ; 6 bytes: Line 1 of the compass [$d3 $d4 $d5 $d6 $d7 $d8] (font 1)
rw  056b,6   DISP_CMPS_L2           ; 6 bytes: Line 2 of the compass [$83 $84 $85 $86 $87 $88] (font 2)
rw  0593,6   DISP_CMPS_L3           ; 6 bytes: Line 3 of the compass [$ab $ac $ad $ae $af $b0] (font 2)
rw  05bb,6   DISP_CMPS_L4           ; 6 bytes: Line 4 of the compass [$d3 $d4 $d5 $d6 $d7 $d8] (font 2)
rw  05e3,6   DISP_CMPS_L5           ; 6 bytes: Line 5 of the compass [$83 $84 $85 $86 $87 $88] (font 3)

; The following are for reference, but aren't actually updated while navigating
; Instead, the bits of the underlying character set are updated to change the display.
; (Note sign bit is set on these values so they are drawn inverted)
;   Up arrow:    [$c9 $ca $cb] (font 1), [$f1 $f2 $f3] (font 1), [$a1 $a2 $a3] (font 2)
;   Left arrow:  [$9f $a0 $a1] (font 2), [$c7 $c8 $c9] (font 2), [$ef $f0 $f1] (font 2)
;   Right arrow: [$a3 $a4 $a5] (font 2), [$cb $cc $cd] (font 2), [$f3 $f4 $f5] (font 2)
;   Down arrow:  [$f1 $f2 $f3] (font 2), [$a1 $a2 $a3] (font 3), [$c9 $ca $cb] (font 3)
rw  0537,7   DISPL_ARWS_L1          ; 7 bytes: Line 1 of direction arrows [$c7 $c8 $c9 $ca $cb $cc $cd] (font 1)
