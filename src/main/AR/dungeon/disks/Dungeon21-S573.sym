; $ac00 - 5120 bytes: Location where maps are loaded into memory

rw  af00,7d  ZoneRefTbl             ; 125 bytes: Zone reference table for the currently loaded map

rw  af00,1   ZoneRefsSize           ; Number of entries in the table, minus one
rw  af01,1   ZoneRefY1              ; Lower Y limit for the zone (inclusive)
rw  af02,1   ZoneRefX2              ; Upper X limit for the zone (exclusive)
rw  af03,1   ZoneRefY2              ; Upper Y limit for the zone (exclusive)
rw  af04,1   ZoneRefX1              ; Lower X limit for the zone (inclusive)
rw  af05,1   ZoneRefId              ; ID of the zone to apply to the cells in the region

    ; Table of zone definitions (8 bytes per entry; entry 0 is default and not referenced in zone region table)
rw  af7e,82  ZoneDefTbl             ; 130 bytes: Zone definition table for the currently loaded map

rw  af7e,1   ZoneDefTex             ; Texture set ID to use for the zone
rw  af7f,1   ZoneDefWarmUnk         ; Zone definition byte B (high nibble = zone warmth; low nibble = ??)
rw  af80,1   ZoneDef_Flags          ; Bitfield incl. light level bit
    ; For color details see: https://www.atariwiki.org/wiki/Wiki.jsp?page=Color%20names
rw  af81,1   ZoneDefWallClr1        ; Wall color #1
rw  af82,1   ZoneDefWallClr2        ; Wall color #2
rw  af83,1   ZoneDefWallClr3        ; Wall color #3
rw  af84,1   ZoneDefCeilClr         ; Ceiling color
rw  af85,1   ZoneDefFlrClr          ; Floor color

    ; Map cell wall, description and special codes
rw  b000,1000 MapCells              ; 4096 bytes: Map cell wall, description and special codes
rw  b000,1   MapWall_E_N            ; Map cell E/N wall byte (high nibble = East; low nibble = North)
rw  b001,1   MapWall_W_S            ; Map cell W/S wall byte (High nibble = West; low nibble = South)
rw  b002,1   MAP_LOC_DESCR          ; First map cell description index byte
rw  b003,1   MAP_SPECIAL            ; First map cell special code byte

