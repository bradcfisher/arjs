Altirra symbol file

; Symbols for Dungeon Disk 3 Side 1 sector 115
;   Module 2: Item Data
;
; Should be applied along with Dungeon11-S518.sym and Dungeon11-S205.sym for full symbol mapping.
;
[symbols]

rwx 7608,4   initModule2            ; Entry point called after the module is loaded.

rwx 7627,1   contRtrnToGame         ; contAddItems continues here to return control back to the main game loop

rwx 763b,1   contAddItems           ; Entry point called from the main game loop which handles adding item(s) to the
                                    ;     game then returns to normal game play.

rwx 769b,1   selectReward           ; Randomly chooses an item from a provided category and adds the item to the
                                    ;     game inventory.
rwx 76d3,1   addNewItem             ; Adds a new item to the game inventory & dropped item list.
rwx 773a,1   lostQuestItem          ; Identifies a quest item which the player should have in their inventory, but
                                    ;     which is not present (for example, if the player dropped the item).
rwx 78a1,1   isQuestFlagSet         ; Tests whether a QuestFlags bit is set.
rwx 78a8,1   hasQuestItem           ; Searches the items in the game for a type 7 (Quest/Special) item with attribute
                                    ;     byte 0 equal to 2 and attribute byte 1 equal to the value provided in A.
rwx 78d5,1   hasQuestItmBfr         ; Searches the items in the game prior to the index in QuestItemIndex for a
                                    ;     type 7 (Quest/Special) item with attribute byte 0 equal to 2 and attribute
                                    ;     byte 1 equal to the value provided in QuestItemId.
rwx 78dc,1   contItmFndRts          ; hasQuestItem/hasQuestItmBfr: Exit point called when a matching item is found.

; ---
; Data segment starts here
; ---

rw  78de,1   ItemRoll               ; selectReward: Assigned the random byte used to determine the item chosen.
rw  78df,1   ModuleStatusPg         ; The number of the status page added when the module was initialized

rw  78e0,1   QuestItemId            ; (hasQuestItmBfr param) Quest item ID value to match to item attribute byte 1
rw  78e1,1   QuestItemIndex         ; (hasQuestItmBfr param) The starting item index. Only items with an index less
                                    ;     than this value will be inspected. Must be between 1 and 64 (both inclusive).
                                    ; (hasQuestItm/hasQuestItmBfr output) Index at which the quest item was found
                                    ;     or $ff if not found.
rw  78e2,1   NumStaffFlags          ; (temp) lostQuestItem: Used to count number of staff piece quest completion flags
                                    ;     set. Note this is not initialized in the sub itself, and thus may only be
                                    ;     valid for the first call to the sub after the module is loaded.
rw  78e3,1   NumStaffPieces         ; (temp) lostQuestItem: Used to count number of staff pieces in inventory. Note this
                                    ;     is not initialized in the sub itself, and thus may only be valid for the
                                    ;     first call to the sub after the module is loaded.
rw  78e4,1   Num                    ; (temp) lostQuestItem: Loop control var
rw  78e5,1   StaffQuestBit          ; (temp) lostQuestItem: Holds quest bit index to test for staff piece loop

