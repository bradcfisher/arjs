Altirra symbol file

[symbols]
; Useful link https://www.atariarchives.org/mapping/memorymap.php#54272


rwx 7649,1  CHK_IF_MAP4_ZONE1       ; Appears to check if the player is in ZONE 1 of MAP 4 (Dungeon Level 2)
rwx 766e,1  CHK_IF_MAP4_ZONE8       ; Appears to check if the player is in ZONE 8 of MAP 4 (Dungeon Level 2)

; Table of stairwell locations used by the stairwell module (5)
rw  7751,1  MOD_STAIR_FROM_TBL1_X   ; New x position for the player on the new map
rw  7752,1  MOD_STAIR_FROM_TBL1_Y   ; New y position for the player on the new map
rw  7753,1  MOD_STAIR_FROM_TBL1_MAP ; Number/ID of the new map to load
rw  7754,1  MOD_STAIR_FROM_TBL1_ORIENT ; Orientation to leave player in after loading the new map

; Table of ?? (at least 6...) 4 byte teleport records. Offset into table read from LOGCOL ($0063)
rw  777d,1  MOD_STAIR_TO_TBL_X      ; New x position for the player on the new map
rw  777e,1  MOD_STAIR_TO_TBL_Y      ; New y position for the player on the new map
rw  777f,1  MOD_STAIR_TO_TBL_MAP    ; Number/ID of the new map to load
rw  7780,1  MOD_STAIR_TO_TBL_ORIENT ; Orientation to leave player in after loading the new map

rw  77Fb,1  UNK_LIGHT_LEVEL_77FB    ; Updated to light level from zone/torch if different (used in display rendering?)
rw  77Fc,1  UNK_NUM_COMPASSES_77FC  ; Updated to value in InvCompasses if different (used in display rendering?)

rw  7a9a,1  ORIENT_VAL1             ; Value read from $7ABC+CHAR_LOC_ORIENT
rw  7aa0,1  ORIENT_VAL2             ; Value read from $7AC0+CHAR_LOC_ORIENT
rw  7aab,1  ORIENT_VAL3             ; Value read from $7AC4+CHAR_LOC_ORIENT
rw  7ab1,1  ORIENT_VAL4             ; Value read from $7AC8+CHAR_LOC_ORIENT

rw  7abc,1  ORIENT_VAL1_TBL         ; Table of bytes indexed by CHR_LOC_ORIENT (result stored in $7A9A) [$04 $80 $fc $80]
rw  7ac0,1  ORIENT_VAL2_TBL         ; Table of bytes indexed by CHR_LOC_ORIENT (result stored in $7AA0) [$00 $00 $ff $ff]
rw  7ac4,1  ORIENT_VAL3_TBL         ; Table of bytes indexed by CHR_LOC_ORIENT (result stored in $7AAB) [$54 $7c $ac $84]
rw  7ac8,1  ORIENT_VAL4_TBL         ; Table of bytes indexed by CHR_LOC_ORIENT (result stored in $7AB1) [$00 $fa $ff $05]

