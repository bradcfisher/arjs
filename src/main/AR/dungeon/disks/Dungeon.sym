; Location where textures are loaded into memory (5392 bytes [$1510])
rw  96f0,1  TEX_HEADERS             ; [$0000] Texture set headers (33 bytes)
rw  9711,1  TEX_UNKNOWN_0           ; [$0021] Unknown 72 bytes
rw  9759,1  TEX_FULL_1              ; [$0069] First full-size texture image (72x72, 2bpp, 1296 bytes)
rw  9c69,1  TEX_HALF_1              ; [$0579] First half-size texture image (36x36, 2bpp, 324 bytes)
rw  9dad,1  TEX_QUARTER_1           ; [$06BD] First quarter-size texture image (20x18, 2bpp, 90 bytes; eff. 18x18 last 2px in each row ignored)
rw  9e07,1  TEX_UNKNOWN_1           ; [$0717] Unknown 72 bytes
rw  9e4f,1  TEX_FULL_2              ; [$075F] Second full-size texture image (72x72, 2bpp, 1296 bytes)
rw  a35f,1  TEX_HALF_2              ; [$0C6F] Second half-size texture image (36x36, 2bpp, 324 bytes)
rw  a4a3,1  TEX_QUARTER_2           ; [$0DB3] Second quarter-size texture image (20x18, 2bpp, 90 bytes; eff. 18x18 last 2px in each row ignored)
rw  a4fd,1  TEX_UNKNOWN_2           ; [$0E0D] Unknown 72 bytes
rw  a545,1  TEX_FULL_3              ; [$0E55] Third full-size texture image (72x72, 2bpp, 1296 bytes)
rw  aa55,1  TEX_HALF_3              ; [$1365] Third half-size texture image (36x36, 2bpp, 324 bytes)
rw  ab99,1  TEX_QUARTER_3           ; [$14A9] Third quarter-size texture image
                                    ; (20x18, 2bpp, 90 bytes; eff. 18x18 last 2px in each row ignored)
rw  ABF3,1  TEX_FILLER              ; [$1503] Possible filler (13 bytes)

; Start of map data (5120 bytes [$1400])
rw  ac00,1  MapNumber               ; Number/ID of the loaded map
rw  ac01,1  MAP_MSG_TBL_L           ; LSB of location description table address
rw  ac02,1  MAP_MSG_TBL_H           ; MSB of location description table address (always $ac e.g. map data start page)
                                    ;    Map 0 (L1NW) - $ac47 "toast! LEV 1.1"
                                    ;    Map 1 (L1NE) - $ac9a "toast! LEV 1.2"
                                    ;    Map 2 (L1SW) - $ac6f "toast! LEV 1.3"
                                    ;    Map 3 (L1SE) - $ac9b "toast! LEV 1.4"
                                    ;    Map 4 (L2)   - $ac44 "toast! LEV 2"
                                    ;    Map 5 (L3)   - $ac4b "toast! LEV 3"
                                    ;    Map 6 (L4)   - $ac0e "toast! LEV 4"
rw  ac03,1  MAP_DescFragTbl         ; Start of message fragment table
rw  af00,1  MAP_ZONERGN_TBL_SIZE    ; Number of zone regions

; Table of zone region definitions (5 bytes per entry)
rw  af01,1  MAP_ZONERGN_Y1          ; Y1 coordinate of zone region
rw  af02,1  MAP_ZONERGN_X2          ; X2 coordinate of zone region
rw  af03,1  MAP_ZONERGN_Y2          ; Y2 coordinate of zone region
rw  af04,1  MAP_ZONERGN_X1          ; X1 coordinate of zone region
rw  af04,1  MAP_ZONERGN_REF         ; Zone definition ID the region applies to
; Table of zone definitions (8 bytes per entry; entry 0 is default and not ref from zone regions)
rw  af7e,1  MAP_ZONEDEF_TEXTURE     ; Texture set ID
rw  af7f,1  MAP_ZONEDEF_B           ; Zone definition byte B
rw  af80,1  MAP_ZONEDEF_FLAGS       ; Bitfield incl. light level bit
; For color details see: https://www.atariwiki.org/wiki/Wiki.jsp?page=Color%20names
rw  af81,1  MAP_ZONEDEF_WALL_CLR1   ; Wall color #1
rw  af82,1  MAP_ZONEDEF_WALL_CLR2   ; Wall color #2
rw  af83,1  MAP_ZONEDEF_WALL_CLR3   ; Wall color #3
rw  af84,1  MAP_ZONEDEF_CLNG_CLR    ; Ceiling color
rw  af85,1  MAP_ZONEDEF_FLR_CLR     ; Floor color
rw  b000,1  MAP_WALL_E_N            ; First map cell E/N wall byte (high nibble = East; low nibble = North)
rw  b001,1  MAP_WALL_W_S            ; First map cell W/S wall byte (High nibble = West; low nibble = South)
rw  b002,1  MAP_LOC_DESCR           ; First map cell description index byte
rw  b003,1  MAP_SPECIAL             ; First map cell special code byte

; c000 - start of second copy of map
; dc00 - start of second copy of texture
